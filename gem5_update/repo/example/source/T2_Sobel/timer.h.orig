#pragma once

#include "Sobel.h"

#include <cstdio>
#include <time.h>

inline long long time_in_ns(const timespec& time)
{
    return time.tv_sec * 1000000000LL + time.tv_nsec;
}

inline void run_sobel_timed(const u32* image, u8* output, u32 threshold2)
{
    constexpr int RUNS = 3000;

    // Warm up QEMU and the caches. This run is not included in the average.
    sobel_image_mag2_thresh(image, output, threshold2);

    long long total_ns = 0;

    for (int run = 0; run < RUNS; ++run)
    {
        timespec start{};
        timespec end{};

        clock_gettime(CLOCK_MONOTONIC, &start);
        sobel_image_mag2_thresh(image, output, threshold2);
        clock_gettime(CLOCK_MONOTONIC, &end);

        total_ns += time_in_ns(end) - time_in_ns(start);
    }

    const long long average_us = (total_ns / RUNS) / 1000;
    std::printf("Average Sobel time (%d runs): %lld us\n",
                RUNS, average_us);
}
